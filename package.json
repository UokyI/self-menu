{
  "name": "self-menu",
  "displayName": "Self Menu",
  "description": "Run custom shell commands from a configurable right-click submenu",
  "version": "0.0.1",
  "publisher": "self-menu",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/UokyI/self-menu.git"
  },
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "self-menu.configure",
        "title": "Self Menu: Configure Items",
        "category": "Self Menu"
      },
      {
        "command": "self-menu.execute",
        "title": "Self Menu (QuickPick)",
        "category": "Self Menu"
      },
      {
        "command": "self-menu.run.0",
        "title": "wwwww",
        "category": "Self Menu"
      },
      {
        "command": "self-menu.run.1",
        "title": "111",
        "category": "Self Menu"
      },
      {
        "command": "self-menu.run.2",
        "title": "获取当前环境变量",
        "category": "Self Menu"
      },
      {
        "command": "self-menu.run.3",
        "title": "时间",
        "category": "Self Menu"
      },
      {
        "command": "self-menu.run.4",
        "title": "测试",
        "category": "Self Menu"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "self-menu.submenu",
          "group": "self-menu@1"
        }
      ],
      "explorer/context": [
        {
          "submenu": "self-menu.submenu",
          "group": "self-menu@1"
        }
      ],
      "self-menu.submenu": [
        {
          "command": "self-menu.run.0",
          "group": "self-menu"
        },
        {
          "command": "self-menu.run.1",
          "group": "self-menu"
        },
        {
          "command": "self-menu.run.2",
          "group": "self-menu"
        },
        {
          "command": "self-menu.run.3",
          "group": "self-menu"
        },
        {
          "command": "self-menu.run.4",
          "group": "self-menu"
        },
        {
          "command": "self-menu.configure",
          "group": "self-menu@99"
        }
      ]
    },
    "submenus": [
      {
        "id": "self-menu.submenu",
        "label": "Self Menu"
      }
    ],
    "configuration": {
      "title": "Self Menu",
      "properties": {
        "self-menu.items": {
          "type": "array",
          "description": "Menu items shown in the right-click submenu. Each item opens a terminal and runs the configured shell command.",
          "default": [],
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "description": "Display name of the menu item"
              },
              "command": {
                "type": "string",
                "description": "Shell command to execute"
              },
              "description": {
                "type": "string",
                "description": "Optional short description shown in the picker"
              },
              "cwd": {
                "type": "string",
                "description": "Optional working directory for the terminal. Supports variables: ${workspaceFolder} ${file} ${path} ${dir} ${name} ${extname} ${basename}"
              }
            },
            "required": [
              "label",
              "command"
            ]
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "^18.0.0",
    "typescript": "^5.3.0"
  }
}