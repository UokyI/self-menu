{
  "name": "self-sub-menu",
  "displayName": "Self Sub Menu",
  "description": "Run custom shell commands from a configurable right-click submenu",
  "version": "0.0.1",
  "publisher": "uokyi",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/UokyI/self-sub-menu.git"
  },
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "self-menu.configure",
        "title": "%self-menu.command.configure%",
        "category": "Self Sub Menu"
      },
      {
        "command": "self-menu.execute",
        "title": "%self-menu.command.execute%",
        "category": "Self Sub Menu"
      },
      {
        "command": "self-menu.run.0",
        "title": "wwwww",
        "category": "Self Sub Menu"
      },
      {
        "command": "self-menu.run.1",
        "title": "111",
        "category": "Self Sub Menu"
      },
      {
        "command": "self-menu.run.2",
        "title": "获取当前环境变量",
        "category": "Self Sub Menu"
      },
      {
        "command": "self-menu.run.3",
        "title": "时间",
        "category": "Self Sub Menu"
      },
      {
        "command": "self-menu.run.4",
        "title": "测试",
        "category": "Self Sub Menu"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "self-menu.submenu",
          "group": "self-menu@1"
        }
      ],
      "explorer/context": [
        {
          "submenu": "self-menu.submenu",
          "group": "self-menu@1"
        }
      ],
      "self-menu.submenu": [
        {
          "command": "self-menu.run.0",
          "group": "self-menu"
        },
        {
          "command": "self-menu.run.1",
          "group": "self-menu"
        },
        {
          "command": "self-menu.run.2",
          "group": "self-menu"
        },
        {
          "command": "self-menu.run.3",
          "group": "self-menu"
        },
        {
          "command": "self-menu.run.4",
          "group": "self-menu"
        },
        {
          "command": "self-menu.configure",
          "group": "self-menu@99"
        }
      ]
    },
    "submenus": [
      {
        "id": "self-menu.submenu",
        "label": "%self-menu.submenu.label%"
      }
    ],
    "configuration": {
      "title": "%self-menu.config.title%",
      "properties": {
        "self-menu.items": {
          "type": "array",
          "description": "%self-menu.items.description%",
          "default": [],
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "description": "%self-menu.items.label.description%"
              },
              "command": {
                "type": "string",
                "description": "%self-menu.items.command.description%"
              },
              "description": {
                "type": "string",
                "description": "%self-menu.items.description.description%"
              },
              "cwd": {
                "type": "string",
                "description": "%self-menu.items.cwd.description%"
              }
            },
            "required": [
              "label",
              "command"
            ]
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "^18.0.0",
    "typescript": "^5.3.0"
  }
}